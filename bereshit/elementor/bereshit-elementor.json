{"version": "0.4", "title": "בראשית – מליס הדר", "type": "page", "content": [{"id": "be5a000a", "elType": "container", "isInner": false, "settings": {"flex_direction": "column", "content_width": "full", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "flex_gap": {"unit": "px", "column": "0", "row": "0", "isLinked": true}, "css_classes": "bsh-root"}, "elements": [{"id": "be5a0002", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\"><link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@200;300;400;500&family=Gveret+Levin&display=swap\" rel=\"stylesheet\"><style>:root{\n  --cream:#faf5ec; --cream-2:#f3ebdd; --beige:#eadcc4; --ink:#2f2f2a; --muted:#5d5a4f;\n  --olive:#3f4435; --forest:#4a5240; --gold:#c49a52; --line:#e6dccb;\n  --max:1240px; --r:18px;\n}\n*{box-sizing:border-box;margin:0}\nhtml{scroll-behavior:smooth;scroll-padding-top:90px}\nbody{font-family:'Heebo',system-ui,sans-serif;font-weight:300;color:var(--ink);background:var(--cream);line-height:1.7;-webkit-font-smoothing:antialiased}\nimg{display:block;max-width:100%}\na{color:inherit;text-decoration:none}\nh1,h2,h3{font-weight:300;line-height:1.15}\n.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}\n.skip{position:absolute;top:-60px;right:8px;background:var(--olive);color:#fff;padding:8px 14px;border-radius:8px;z-index:100}\n.skip:focus{top:8px}\n.ico{width:18px;height:18px;flex:none}\n.ico-lg{width:42px;height:42px;color:var(--gold);flex:none}\n.ico-sun{width:44px;height:44px;color:var(--gold)}\n.ico-wa{width:22px;height:22px;color:var(--gold)}\n.rule{display:block;width:36px;height:1px;background:var(--gold)}\n.rule.center{margin:14px auto 0}\n.eyebrow{color:var(--gold);font-size:.85rem;letter-spacing:.06em;font-weight:400}\n.sub{color:var(--muted);font-size:1.05rem}\n\n.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;background:var(--olive);color:#fff;border-radius:999px;padding:15px 34px;font-size:1rem;font-weight:400;border:0;cursor:pointer;font-family:inherit;transition:background .2s,transform .2s}\n.btn:hover{background:#2c3024;transform:translateY(-1px)}\n.btn:focus-visible,a:focus-visible,summary:focus-visible,input:focus-visible{outline:2px solid var(--gold);outline-offset:3px}\n.btn-sm{padding:10px 22px;font-size:.9rem}\n.btn-block{width:100%}\n.btn:disabled{opacity:.6;cursor:wait}\n\n/* header */\n.site-header{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px clamp(16px,4vw,48px);background:rgba(250,245,236,.92);backdrop-filter:blur(8px)}\n.brand img{height:46px;width:auto}\n.nav{display:flex;gap:0;font-size:.92rem}\n.nav a{padding:0 22px;border-inline-start:1px solid var(--line)}\n.nav a:first-child{border-inline-start:0}\n.nav a:hover{color:var(--gold)}\n\n/* hero */\n.hero{position:relative;display:grid;grid-template-columns:1fr 1fr;min-height:min(78vh,720px);overflow:hidden;background:var(--cream-2)}\n.hero-img{position:absolute;inset:0 auto 0 0;width:68%}\n.hero-img img{width:100%;height:100%;object-fit:cover;object-position:30% 62%}\n.hero-panel{grid-column:1;position:relative;display:flex;align-items:center;justify-content:center;background:linear-gradient(160deg,#fbf6ec,#f1e6d2);padding:48px clamp(24px,5vw,80px);\n  border-radius:55% 0 0 55% / 100% 0 0 100%;box-shadow:-30px 0 60px -30px rgba(60,50,30,.25)}\n.hero-copy{position:relative;display:flex;flex-direction:column;align-items:center;text-align:center;gap:18px;max-width:440px}\n.hero-copy h1{font-size:clamp(2.6rem,5.2vw,4.6rem);font-weight:300;letter-spacing:-.01em}\n.hero-copy .lead{font-size:1.2rem;color:var(--muted);line-height:1.6}\n.more{display:inline-flex;align-items:center;gap:6px;font-size:.85rem;color:var(--muted)}\n\n/* trust */\n.trust{display:grid;grid-template-columns:repeat(3,1fr);max-width:var(--max);margin:0 auto;padding:32px 24px}\n.trust-item{display:flex;align-items:center;justify-content:center;gap:16px;font-size:1.05rem;font-weight:400;border-inline-start:1px solid var(--line)}\n.trust-item:first-child{border-inline-start:0}\n.trust-item .ico-lg{width:34px;height:34px}\n\n/* change */\n.change{background:var(--cream-2);padding:72px 24px;text-align:center}\n.change h2,.steps h2,.faq h2{font-size:clamp(1.8rem,3.4vw,2.7rem)}\n.change .sub{margin:8px 0 40px}\n.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:var(--max);margin:0 auto}\n.card{background:var(--cream);border:1px solid var(--line);border-radius:var(--r);padding:30px 20px;display:flex;flex-direction:column;align-items:center;gap:10px;transition:transform .25s,box-shadow .25s}\n.card:hover{transform:translateY(-4px);box-shadow:0 12px 30px -16px rgba(60,50,30,.35)}\n.card h3{font-size:1.25rem;font-weight:400;margin-top:6px}\n.card p{color:var(--muted);font-size:.95rem}\n\n/* about */\n.about{display:grid;grid-template-columns:1fr 1.15fr;align-items:stretch;background:var(--cream)}\n.about-text{padding:clamp(40px,6vw,90px) clamp(24px,5vw,80px);display:flex;flex-direction:column;gap:18px;justify-content:center;max-width:620px;margin-inline-start:auto}\n.about-text h2{font-size:clamp(2.2rem,4.2vw,3.4rem)}\n.about-text p{color:var(--muted)}\n.signature{display:flex;align-items:center;gap:14px;margin-top:6px}\n.signature .rule{width:46px}\n.sig{font-family:'Gveret Levin',cursive;font-size:2rem;color:var(--ink);transform:rotate(-4deg)}\n.about-img{position:relative;overflow:hidden;min-height:420px}\n.about-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 70%}\n.about-img::after{content:\"\";position:absolute;inset:0 0 0 auto;width:120px;background:var(--cream);border-radius:100% 0 0 100% / 50%;transform:translateX(60px)}\n\n/* steps */\n.steps{background:var(--forest);color:#f3ecdc;text-align:center;padding:64px 24px 72px;position:relative;overflow:hidden}\n.steps .sub{color:#d3cdb8;margin:8px 0 44px}\n.steps-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(3,1fr);max-width:var(--max);margin:0 auto;text-align:start}\n.steps-grid li{padding:6px 36px;border-inline-start:1px solid rgba(196,154,82,.45)}\n.steps-grid li:first-child{border-inline-start:0}\n.num{display:block;font-size:2.8rem;color:var(--gold);font-weight:300;line-height:1.2}\n.steps-grid h3{font-size:1.3rem;font-weight:400;margin:4px 0 8px}\n.steps-grid p{color:#d3cdb8;font-size:.95rem}\n\n/* training */\n.training{display:grid;grid-template-columns:1.1fr 1fr;align-items:center;background:var(--cream);overflow:hidden}\n.training-text{display:flex;flex-direction:column;gap:18px;padding:60px clamp(24px,5vw,80px);max-width:640px;margin-inline-start:auto;align-items:flex-start}\n.training-text h2{font-size:clamp(2rem,4vw,3.2rem)}\n.training-text p{color:var(--muted)}\n.training-img{position:relative;height:100%;min-height:420px}\n.training-img>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;border-start-start-radius:0;border-radius:50% 0 0 0 / 38% 0 0 0}\n.inset{position:absolute;inset-block-end:28px;inset-inline-start:28px;width:min(34%,230px);aspect-ratio:1/1.05;border:3px solid #fff;border-radius:16px;overflow:hidden;box-shadow:0 10px 30px -10px rgba(0,0,0,.35)}\n.inset img{width:100%;height:100%;object-fit:cover;object-position:55% 40%}\n\n/* faq */\n.faq{padding:64px 24px 72px;text-align:center;background:var(--cream)}\n.faq-list{max-width:1100px;margin:34px auto 0;display:grid;gap:12px;text-align:start}\ndetails{background:#fffaf1;border:1px solid var(--line);border-radius:12px}\nsummary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:16px 22px;font-weight:400;font-size:1.02rem}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";color:var(--gold);font-size:1.5rem;line-height:1;font-weight:200;order:-1}\ndetails[open] summary::after{content:\"–\"}\ndetails p{padding:0 22px 20px;color:var(--muted)}\n\n/* cta */\n.cta{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;background:linear-gradient(90deg,#eadcc4,#f0e3cd);border-radius:0 80px 0 0;overflow:hidden}\n.cta-form{padding:clamp(40px,6vw,80px) clamp(24px,6vw,90px);display:flex;flex-direction:column;gap:14px;max-width:640px;margin-inline-start:auto;width:100%}\n.cta-form h2{font-size:clamp(1.8rem,3.4vw,2.6rem)}\n.cta-form .sub{margin-bottom:10px}\nform{display:flex;flex-direction:column;gap:12px}\ninput[type=text],input[type=tel]{font:inherit;width:100%;padding:15px 20px;border:1px solid var(--line);border-radius:10px;background:#fffdf8;color:var(--ink)}\ninput::placeholder{color:#9b958a}\n.hp{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);opacity:0}\n.form-msg{min-height:1.4em;font-size:.92rem;text-align:center}\n.form-msg.ok{color:#3c6b37}.form-msg.err{color:#a3402d}\n.wa{display:inline-flex;align-items:center;justify-content:center;gap:10px;color:var(--muted);font-size:.95rem;margin-top:4px}\n.wa:hover{color:var(--ink)}\n.cta-img{position:relative;min-height:380px}\n.cta-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:20% 40%;border-radius:0 0 0 0}\n\n/* footer */\n.site-footer{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:20px;padding:28px clamp(16px,4vw,48px);background:var(--cream)}\n.social{display:flex;gap:16px}\n.social a{display:grid;place-items:center;width:34px;height:34px}\n.social a:hover{color:var(--gold)}\n.brand-foot img{height:54px}\n.legal{display:flex;gap:12px;justify-content:flex-end;font-size:.85rem;color:var(--muted)}\n.legal span{color:var(--line)}\n.legal a:hover{color:var(--ink)}\n\n/* responsive */\n@media (max-width:900px){\n  .nav{display:none}\n  .hero{grid-template-columns:1fr;min-height:0}\n  .hero-img{position:relative;width:100%;height:56vh;inset:auto;grid-column:1;grid-row:1}\n  .hero-img img{object-position:25% 35%}\n  .hero-panel{grid-row:2;grid-column:1;padding:40px 24px 52px;border-radius:0;box-shadow:none;margin-top:-28px;border-radius:28px 28px 0 0;z-index:1}\n  .trust{grid-template-columns:1fr;gap:18px;padding:24px}\n  .trust-item{border:0;justify-content:flex-start}\n  .cards{grid-template-columns:repeat(2,1fr)}\n  .about,.training,.cta{grid-template-columns:1fr}\n  .about-text,.training-text,.cta-form{max-width:none}\n  .about-img{min-height:320px}.about-img::after{display:none}\n  .training-img{min-height:360px}\n  .training-img>img{border-radius:0}\n  .steps-grid{grid-template-columns:1fr;gap:28px}\n  .steps-grid li{border:0;padding:0 8px;border-top:0}\n  .cta{border-radius:0 48px 0 0}\n  .cta-img{min-height:240px;order:2}\n  .site-footer{grid-template-columns:1fr;justify-items:center;text-align:center}\n  .legal{justify-content:center}\n}\n@media (max-width:520px){\n  .cards{grid-template-columns:1fr}\n  .btn-sm{padding:9px 16px}\n  .brand img{height:38px}\n}\n@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n\n/* --- Elementor integration --- */\nbody.elementor-page{background:var(--cream)}\n.bsh .elementor-widget-container{margin:0}\n.bsh-cta{display:grid!important;grid-template-columns:1fr 1fr;background:linear-gradient(90deg,#eadcc4,#f0e3cd);border-radius:0 80px 0 0;overflow:hidden;--gap:0px;padding:0!important}\n.bsh-cta-form{padding:clamp(40px,6vw,80px) clamp(24px,6vw,90px)!important;max-width:640px;margin-inline-start:auto;width:100%;display:flex;flex-direction:column;gap:14px}\n.bsh-cta-form .elementor-field-textual{font:inherit;padding:15px 20px;border:1px solid var(--line);border-radius:10px;background:#fffdf8;color:var(--ink);font-size:1rem}\n.bsh-cta-form .elementor-field-group{margin-bottom:0}\n.bsh-cta-form .elementor-field-label{display:none}\n.bsh-cta-form .elementor-button{border:0;box-shadow:none}\n.bsh-cta-form .elementor-form-fields-wrapper{gap:12px}\n.bsh-cta-form .elementor-button{background:var(--olive)!important;color:#fff;border-radius:999px;padding:16px 34px;font:400 1rem 'Heebo',sans-serif;width:100%}\n.bsh-cta-form .elementor-button:hover{background:#2c3024!important}\n.bsh-cta-form .elementor-message-success{color:#3c6b37;text-align:center}\n.bsh-cta-form .elementor-message-danger{color:#a3402d;text-align:center}\n.bsh-cta .cta-img{min-height:380px;height:100%}\n.bsh-cta .cta-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}\n.bsh-cta .cta-img{position:relative}\n.bsh-cta-form h2,.bsh-cta-form .sub{margin:0}\n@media(max-width:900px){.bsh-cta{grid-template-columns:1fr;border-radius:0 48px 0 0}.bsh-cta .cta-img{min-height:240px;order:2}}\n</style><svg width=\"0\" height=\"0\" style=\"position:absolute\" aria-hidden=\"true\">\n  <defs>\n    <symbol id=\"i-arrow\" viewBox=\"0 0 24 24\"><path d=\"M20 12H5M11 6l-6 6 6 6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n    <symbol id=\"i-chev\" viewBox=\"0 0 24 24\"><path d=\"M6 9l6 6 6-6\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></symbol>\n    <symbol id=\"i-sun\" viewBox=\"0 0 48 48\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\"><circle cx=\"24\" cy=\"24\" r=\"7\"/><path d=\"M24 6v6M24 36v6M6 24h6M36 24h6M11.3 11.3l4.2 4.2M32.5 32.5l4.2 4.2M11.3 36.7l4.2-4.2M32.5 15.5l4.2-4.2\"/></g></symbol>\n    <symbol id=\"i-leaf\" viewBox=\"0 0 48 48\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M10 38C8 22 18 9 38 8c1 19-9 31-25 30\"/><path d=\"M10 40c6-10 13-17 22-23\"/></g></symbol>\n    <symbol id=\"i-people\" viewBox=\"0 0 48 48\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"17\" cy=\"16\" r=\"6\"/><circle cx=\"32\" cy=\"18\" r=\"5\"/><path d=\"M5 40c0-8 5-13 12-13s12 5 12 13M30 28c7-1 13 3 13 11\"/></g></symbol>\n    <symbol id=\"i-heart\" viewBox=\"0 0 48 48\"><path d=\"M24 40C10 30 6 22 6 16.5 6 11 10 8 14.5 8 19 8 22 11 24 14c2-3 5-6 9.5-6C38 8 42 11 42 16.5 42 22 38 30 24 40z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linejoin=\"round\"/></symbol>\n    <symbol id=\"i-lotus\" viewBox=\"0 0 48 48\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 36C18 31 17 22 24 12c7 10 6 19 0 24z\"/><path d=\"M22 35C14 36 8 30 6 20c8 0 14 4 16 15zM26 35c8 1 14-5 16-15-8 0-14 4-16 15z\"/><path d=\"M12 40c8 3 16 3 24 0\"/></g></symbol>\n    <symbol id=\"i-sprout\" viewBox=\"0 0 48 48\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M24 42V22M24 24C24 14 17 10 8 10c0 9 6 14 16 14zM24 28c0-8 6-12 15-12 0 8-6 12-15 12z\"/></g></symbol>\n    <symbol id=\"i-wa\" viewBox=\"0 0 32 32\"><path fill=\"currentColor\" d=\"M16 3C8.800 3 3 8.800 3 16c0 2.300.6 4.5 1.700 6.400L3 29l6.8-1.700A13 13 0 0 0 16 29c7.200 0 13-5.800 13-13S23.200 3 16 3zm0 23.800c-2 0-3.900-.6-5.5-1.600l-.4-.2-4 1 1.100-3.900-.3-.4A10.800 10.800 0 1 1 16 26.800zm5.900-8.100c-.3-.2-1.900-.9-2.200-1-.3-.1-.5-.2-.7.200-.2.300-.8 1-1 1.200-.2.200-.4.200-.7.100-.3-.2-1.400-.5-2.600-1.600-1-.9-1.600-1.900-1.800-2.300-.2-.3 0-.5.100-.7l.5-.5c.1-.2.200-.3.300-.5.100-.2 0-.4 0-.6l-1-2.300c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.100-.9.400-.3.300-1.100 1.100-1.100 2.700s1.200 3.100 1.300 3.300c.2.200 2.300 3.5 5.600 4.900 3.300 1.400 3.300.9 3.900.9.600-.1 1.900-.8 2.200-1.5.3-.8.300-1.400.2-1.5l-.6-.4z\"/></symbol>\n    <symbol id=\"i-ig\" viewBox=\"0 0 24 24\"><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"5\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"17.2\" cy=\"6.8\" r=\"1\" fill=\"currentColor\"/></g></symbol>\n    <symbol id=\"i-fb\" viewBox=\"0 0 24 24\"><path fill=\"currentColor\" d=\"M13.5 21v-7.800h2.600l.4-3.100h-3V8.200c0-.9.300-1.5 1.600-1.5h1.600V3.900c-.3 0-1.200-.1-2.300-.1-2.300 0-3.900 1.400-3.900 4v2.300H7.900v3.100h2.600V21h3z\"/></symbol>\n  </defs>\n</svg><header class=\"site-header\">\n  <a class=\"brand\" href=\"#top\" aria-label=\"בראשית – מליס הדר\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-logo.png\" alt=\"בראשית – מליס הדר\" width=\"1759\" height=\"489\"></a>\n  <nav class=\"nav\" aria-label=\"ניווט ראשי\">\n    <a href=\"#about\">אודות</a>\n    <a href=\"#method\">השיטה</a>\n    <a href=\"#process\">התהליך האישי</a>\n    <a href=\"#training\">הכשרת מטפלים</a>\n  </nav>\n  <a class=\"btn btn-dark btn-sm\" href=\"#contact\">לתיאום פגישה <svg class=\"ico\"><use href=\"#i-arrow\"/></svg></a>\n</header></div>"}, "elements": []}, {"id": "be5a0003", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\">\n\n<!-- HERO -->\n<section class=\"hero\" id=\"top\">\n  <div class=\"hero-img\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-hero.webp\" alt=\"מליס הדר מקיימת טקס קערת צלילים\" width=\"948\" height=\"1659\" fetchpriority=\"high\"></div>\n  <div class=\"hero-panel\">\n    <div class=\"hero-copy\">\n      <svg class=\"ico-sun\"><use href=\"#i-sun\"/></svg>\n      <p class=\"eyebrow\">מליס הדר · שיטת בראשית</p>\n      <h1>הדרך חזרה<br>לעצמך<br>מתחילה כאן.</h1>\n      <span class=\"rule\"></span>\n      <p class=\"lead\">מסע אישי של הקשבה,<br>מודעות וחיבור פנימי.</p>\n      <a class=\"btn btn-dark\" href=\"#contact\">לתיאום פגישת התאמה <svg class=\"ico\"><use href=\"#i-arrow\"/></svg></a>\n      <a class=\"more\" href=\"#about\"><svg class=\"ico\"><use href=\"#i-chev\"/></svg> להכיר את השיטה</a>\n    </div>\n  </div>\n</section>\n\n<!-- TRUST -->\n<section class=\"trust\" aria-label=\"עיקרי השיטה\">\n  <div class=\"trust-item\"><svg class=\"ico-lg\"><use href=\"#i-sun\"/></svg><span>חיבור פנימי</span></div>\n  <div class=\"trust-item\"><svg class=\"ico-lg\"><use href=\"#i-leaf\"/></svg><span>תהליך אישי</span></div>\n  <div class=\"trust-item\"><svg class=\"ico-lg\"><use href=\"#i-people\"/></svg><span>ליווי בגובה העיניים</span></div>\n</section>\n\n<!-- CHANGE -->\n<section class=\"change\" id=\"method\">\n  <h2>לפעמים, השינוי מתחיל בהקשבה</h2>\n  <p class=\"sub\">אל הדפוסים, הרגשות והקשרים שמבקשים מקום.</p>\n  <div class=\"cards\">\n    <article class=\"card\"><svg class=\"ico-lg\"><use href=\"#i-heart\"/></svg><h3>אהבה עצמית</h3><p>חיבור עמוק ואמיתי<br>אל עצמך.</p></article>\n    <article class=\"card\"><svg class=\"ico-lg\"><use href=\"#i-people\"/></svg><h3>מערכות יחסים</h3><p>להבין דפוסים וליצור<br>קשרים מיטיבים יותר.</p></article>\n    <article class=\"card\"><svg class=\"ico-lg\"><use href=\"#i-lotus\"/></svg><h3>ביטחון פנימי</h3><p>להרגיש יציבות ובהירות<br>בתוך החיים שלך.</p></article>\n    <article class=\"card\"><svg class=\"ico-lg\"><use href=\"#i-sprout\"/></svg><h3>שינוי דפוסים</h3><p>להתבונן, לשחרר<br>ולבחור אחרת.</p></article>\n  </div>\n</section>\n\n<!-- ABOUT -->\n<section class=\"about\" id=\"about\">\n  <div class=\"about-text\">\n    <h2>נעים להכיר,<br>אני מליס.</h2>\n    <p>— מתוך המסע האישי שלי נולדה שיטת בראשית – דרך להתבוננות פנימה ולעבודה עם דפוסים, רגשות ותת-המודע.</p>\n    <p>כיום אני מלווה אנשים בתהליכים אישיים ומעבירה הכשרת מטפלים, מתוך אמונה בכוח הטבעי של כל אדם להתחבר לעצמו ולחיות חיים מדויקים ומלאים יותר.</p>\n    <div class=\"signature\"><span class=\"rule\"></span><span class=\"sig\">מליס הדר</span></div>\n  </div>\n  <div class=\"about-img\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-duo.webp\" alt=\"מליס הדר ושותפה לדרך יושבות ומחייכות באולם מדיטציה\" width=\"1659\" height=\"948\" loading=\"lazy\"></div>\n</section>\n\n<!-- STEPS -->\n<section class=\"steps\" id=\"process\">\n  <h2>לכל דרך יש צעד ראשון</h2>\n  <p class=\"sub\">תהליך מדויק, קשוב ואישי בקצב שלך.</p>\n  <ol class=\"steps-grid\">\n    <li><span class=\"num\">01</span><h3>פגישת חיבור והתאמה</h3><p>שיחה ראשונית להיכרות, לבחינת הצרכים שלך ולהתאמה מדויקת לתהליך.</p></li>\n    <li><span class=\"num\">02</span><h3>היכרות עם הדפוסים</h3><p>התבוננות משותפת על דפוסים, רגשות וקשרים שמבקשים תשומת לב.</p></li>\n    <li><span class=\"num\">03</span><h3>תהליך אישי וליווי</h3><p>מסע של עומק, בהירות וחיבור פנימי, עם כלים שממשיכים איתך גם הלאה.</p></li>\n  </ol>\n</section>\n\n<!-- TRAINING -->\n<section class=\"training\" id=\"training\">\n  <div class=\"training-text\">\n    <p class=\"eyebrow\">הכשרת מטפלים בשיטת בראשית</p>\n    <span class=\"rule\"></span>\n    <h2>להפוך חיבור פנימי<br>לדרך מקצועית.</h2>\n    <p>התהליך לימודי ואישי לאורך שמונה חודשים, למי שמרגיש/ה קריאה להעמיק ולהוביל גם אחרים במסע שלהם.</p>\n    <a class=\"btn btn-dark\" href=\"#contact\">לפרטים על ההכשרה <svg class=\"ico\"><use href=\"#i-arrow\"/></svg></a>\n  </div>\n  <div class=\"training-img\">\n    <img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-arch.webp\" alt=\"חצר עם קשת ועצי זית באור שקיעה\" width=\"844\" height=\"1125\" loading=\"lazy\">\n    <figure class=\"inset\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-duo.webp\" alt=\"\" width=\"1659\" height=\"948\" loading=\"lazy\"></figure>\n  </div>\n</section>\n\n<!-- FAQ -->\n<section class=\"faq\" id=\"faq\">\n  <h2>יש מקום לכל שאלה</h2>\n  <span class=\"rule center\"></span>\n  <div class=\"faq-list\">\n    <details><summary>למי מתאים התהליך?</summary><p>לכל מי שמרגיש/ה שהגיע הזמן להקשיב פנימה: לשחרר דפוסים ישנים, להעמיק את הקשר עם עצמו ולבנות מערכות יחסים מיטיבות יותר. אין צורך בניסיון קודם.</p></details>\n    <details><summary>האם אפשר להיפגש אונליין?</summary><p>בהחלט. אפשר להיפגש פנים אל פנים או בזום, והתהליך שומר על אותו עומק ואותה אינטימיות.</p></details>\n    <details><summary>איך נראית פגישת ההתאמה?</summary><p>שיחה קצרה, ללא עלות וללא התחייבות, שבה נכיר, תשתפו במה שמביא אתכם ונבדוק יחד אם השיטה והליווי מתאימים לכם.</p></details>\n    <details><summary>האם צריך ניסיון קודם?</summary><p>לא. התהליך מותאם לכל אחד ואחת, בין אם זו הפעם הראשונה שלכם בעבודה פנימית ובין אם אתם כבר בדרך.</p></details>\n  </div>\n</section>\n\n\n\n</div>"}, "elements": []}, {"id": "be5a0008", "elType": "container", "isInner": true, "settings": {"flex_direction": "row", "content_width": "full", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "flex_gap": {"unit": "px", "column": "0", "row": "0", "isLinked": true}, "css_classes": "bsh bsh-cta", "container_type": "flex"}, "elements": [{"id": "be5a0006", "elType": "container", "isInner": true, "settings": {"flex_direction": "column", "content_width": "full", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "flex_gap": {"unit": "px", "column": "0", "row": "0", "isLinked": true}, "css_classes": "bsh-cta-form"}, "elements": [{"id": "be5a0004", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\"><h2>הצעד הראשון יכול להיות פשוט</h2>\n    <p class=\"sub\">נשאיר מקום להיכרות, לשאלות ולדרך שמתאימה לך.</p></div>"}, "elements": []}, {"id": "be5a0001", "elType": "widget", "widgetType": "form", "settings": {"form_name": "בראשית – פגישת התאמה", "show_labels": "", "mark_required": "", "form_fields": [{"_id": "name", "custom_id": "name", "field_type": "text", "field_label": "שם מלא", "placeholder": "שם מלא", "required": "true", "width": "100"}, {"_id": "phone", "custom_id": "phone", "field_type": "tel", "field_label": "טלפון", "placeholder": "טלפון", "required": "true", "width": "100"}], "button_text": "אשמח לשמוע עוד", "button_width": "100", "submit_actions": ["email"], "email_to": "nivmozes@gmail.com", "email_subject": "ליד חדש – בראשית", "email_content": "[all-fields]", "email_from_name": "אתר בראשית", "success_message": "תודה! אחזור אלייך בקרוב.", "error_message": "משהו השתבש. אפשר לפנות בווטסאפ."}, "elements": []}, {"id": "be5a0005", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\"><a class=\"wa\" href=\"https://wa.me/972500000000\" target=\"_blank\" rel=\"noopener\"><svg class=\"ico-wa\"><use href=\"#i-wa\"/></svg> או ליצור קשר בווטסאפ</a></div>"}, "elements": []}]}, {"id": "be5a0007", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\"><div class=\"cta-img\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-olive.webp\" alt=\"\" width=\"1024\" height=\"1536\" loading=\"lazy\"></div></div>"}, "elements": []}]}, {"id": "be5a0009", "elType": "widget", "widgetType": "html", "settings": {"html": "<div class=\"bsh\"><footer class=\"site-footer\">\n  <div class=\"social\">\n    <a href=\"https://www.instagram.com/\" target=\"_blank\" rel=\"noopener\" aria-label=\"אינסטגרם\"><svg class=\"ico\"><use href=\"#i-ig\"/></svg></a>\n    <a href=\"https://www.facebook.com/\" target=\"_blank\" rel=\"noopener\" aria-label=\"פייסבוק\"><svg class=\"ico\"><use href=\"#i-fb\"/></svg></a>\n  </div>\n  <a class=\"brand brand-foot\" href=\"#top\" aria-label=\"בראשית – מליס הדר\"><img src=\"https://nivcreative.com/wp-content/uploads/2026/10/bereshit-logo.png\" alt=\"בראשית – מליס הדר\" width=\"1759\" height=\"489\" loading=\"lazy\"></a>\n  <nav class=\"legal\" aria-label=\"קישורים משפטיים\">\n    <a href=\"#contact\">יצירת קשר</a><span>|</span><a href=\"privacy.html\">פרטיות</a><span>|</span><a href=\"accessibility.html\">נגישות</a>\n  </nav>\n</footer></div>"}, "elements": []}]}], "page_settings": {"hide_title": "yes"}}